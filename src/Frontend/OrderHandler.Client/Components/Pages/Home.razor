@page "/"

<PageTitle>Home</PageTitle>


<div class="row mb-5">
	<div class="col-12">
		<h2 class="fw-bolder">Welcome to <span class="text-dark">Order Handler</span> </h2>
	</div>
	<Div class="col-4">
		<Div Background="Background.Light" class="card">
			<Div class="card-body">
				<AuthorizeView>
					<NotAuthorized>
						<span>You are not logged in. Please <a class="fw-bolder" href="/login">click here</a> to login.</span>
					</NotAuthorized>
					<Authorized>
						<span>
							Logged in as <b>
								@if (context.User.Identity != null)
								{
									@context.User.Identity.Name
								}
							</b>. <a class="fw-bolder" href="/logout">Click here</a> to logout.
						</span>
					</Authorized>
				</AuthorizeView>
			</Div>
		</Div>
	</Div>
</div>


<div class="container mb-5">
	<header class="header mt-3">
		<Image Class="card" Border="Border.Is1.Rounded" Source="Images/img4.jpg" Text="Portable computer" Display="Display.Block" Width="Width.Is100" />
	</header>
	<main class="main-content">
		<div class="card" style="background-color:lightcyan">
			<p class="mt-5">
				At Order Handler, we believe in making shopping effortless, affordable, and fun.<br/> Whether you're looking for the latest trends in tech, essential technical equipment, or unique finds, we've got it all under one roof.<br/> Explore our wide range of categories and discover unbeatable offers.
				<br/><br/>
				<Icon Name="IconName.Check"/> <strong>Quality you can trust</strong> – Handpicked products from trusted brands.
				<br/>
				<Icon Name="IconName.Check"/> <strong>Affordable prices</strong> – Competitive deals on everything you love.
				<br/>
				<Icon Name="IconName.Check"/> <strong>Fast shipping</strong> – Enjoy quick, reliable delivery straight to your door.
				<br/>
				<Icon Name="IconName.Check"/> <strong>Customer satisfaction</strong> – Our top priority is you!
				<br/>

				<p class="mt-3">
					<br/> Start shopping today and experience the ease and convenience of <strong>Order Handler!</strong>
				</p>
			</p>
		</div>
	</main>
</div>

